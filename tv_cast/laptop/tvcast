class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def _json(self,obj,code=200):
        b=json.dumps(obj).encode();self.send_response(code)
        self.send_header("Content-Type","application/json");self.send_header("Content-Length",str(len(b)))
        self.end_headers();self.wfile.write(b)
    def _body(self):
        n=int(self.headers.get("Content-Length") or 0)
        try: return json.loads(self.rfile.read(n) or b"{}")
        except Exception: return {}
    def do_GET(self):
        if self.path=="/" or self.path.startswith("/?"):
            b=PAGE.encode();self.send_response(200);self.send_header("Content-Type","text/html; charset=utf-8")
            self.send_header("Content-Length",str(len(b)));self.end_headers();self.wfile.write(b);return
        if self.path=="/api/status": return self._json(CASTER.status())
        if self.path.startswith("/media/"):
            name=urllib.request.unquote(self.path[len("/media/"):])
            root=CASTER.root or "."; p=os.path.normpath(os.path.join(root,name))
            if not p.startswith(os.path.normpath(root)) or not os.path.isfile(p):
                self.send_response(404);self.end_headers();return
            sz=os.path.getsize(p);rng=self.headers.get("Range");start,end=0,sz-1
            if rng:
                m=re.match(r"bytes=(\d+)-(\d*)",rng)
                if m:start=int(m.group(1));end=int(m.group(2)) if m.group(2) else sz-1
            self.send_response(206 if rng else 200)
            self.send_header("Content-Type",mime_for(p))
            self.send_header("contentFeatures.dlna.org", "DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000")
            self.send_header("transferMode.dlna.org", "Streaming")
            self.send_header("Accept-Ranges","bytes")
            if rng:self.send_header("Content-Range",f"bytes {start}-{end}/{sz}")
            self.send_header("Content-Length",str(end-start+1));self.end_headers()
            with open(p,"rb") as f:
                f.seek(start);left=end-start+1
                while left>0:
                    chunk=f.read(min(262144,left))
                    if not chunk:break
                    try:self.wfile.write(chunk)
                    except Exception:return
                    left-=len(chunk)
            return
        self.send_response(404);self.end_headers()
    def do_POST(self):
        b=self._body()
        if self.path=="/api/open": ok,msg=CASTER.open_dir(b.get("dir","")); return self._json({"ok":ok,"msg":msg})
        if self.path=="/api/play": CASTER.play(); return self._json({"ok":True})
        if self.path=="/api/pause": CASTER.pause(); return self._json({"ok":True})
        if self.path=="/api/next": CASTER.nxt(); return self._json({"ok":True})
        if self.path=="/api/prev": CASTER.prev(); return self._json({"ok":True})
        if self.path=="/api/goto": CASTER.goto(int(b.get("i",0))); return self._json({"ok":True})
        if self.path=="/api/stop": CASTER.stop(); return self._json({"ok":True})
        if self.path=="/api/video": ok,msg=CASTER.video(b.get("path","")); return self._json({"ok":ok,"msg":msg})
        if self.path=="/api/tv": CASTER.set_tv(b.get("tv",DEFAULT_TV)); return self._json({"ok":True})
        if self.path=="/api/cfg":
            if "secs" in b: CASTER.secs=max(1.0,float(b["secs"]))
            if "loop" in b: CASTER.loop=bool(b["loop"])
            return self._json({"ok":True})
        self._json({"ok":False,"msg":"unknown"},404)

def all_ips():
    ips=set()
    for host in ("8.8.8.8","192.168.89.9"):
        try:
            s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);s.connect((host,80));ips.add(s.getsockname()[0]);s.close()
        except Exception: pass
    return sorted(ips)

def main():
    global CASTER
    ap=argparse.ArgumentParser()
    sub=ap.add_subparsers(dest="cmd")
    s=sub.add_parser("serve"); s.add_argument("--port",type=int,default=8808); s.add_argument("--tv",default=DEFAULT_TV); s.add_argument("--dir",default=None)
    sl=sub.add_parser("slides"); sl.add_argument("folder"); sl.add_argument("--secs",type=float,default=5); sl.add_argument("--loop",action="store_true"); sl.add_argument("--tv",default=DEFAULT_TV)
    v=sub.add_parser("video"); v.add_argument("file"); v.add_argument("--tv",default=DEFAULT_TV)
    st=sub.add_parser("stop"); st.add_argument("--tv",default=DEFAULT_TV)
    a=ap.parse_args()
    if not a.cmd: ap.print_help(); return

    if a.cmd=="stop":
        CASTER=Caster(a.tv,0); CASTER.stop(); print("Stopped TV playback."); return

    port = a.port if a.cmd=="serve" else 8809
    CASTER=Caster(a.tv,port)
    httpd=http.server.ThreadingHTTPServer(("0.0.0.0",port),Handler)
    threading.Thread(target=httpd.serve_forever,daemon=True).start()

    if a.cmd=="serve":
        if a.dir:
            ok,msg=CASTER.open_dir(a.dir); print("folder:",msg)
        print("tvcast control panel:")
        for ip in all_ips(): print(f"   http://{ip}:{port}/")
        print(f"   http://localhost:{port}/   (TV {a.tv})")
        print("Open it from this laptop or any phone on the same Wi-Fi. Ctrl-C to quit.")
        try:
            while True: time.sleep(3600)
        except KeyboardInterrupt: print("\nbye")
    elif a.cmd=="slides":
        ok,msg=CASTER.open_dir(a.folder)
        if not ok: sys.exit(msg)
        CASTER.secs=a.secs; CASTER.loop=a.loop; print(f"slides: {msg}, {a.secs}s each, loop={a.loop}. Ctrl-C to stop.")
        CASTER.play()
        try:
            while True: time.sleep(3600)
        except KeyboardInterrupt: CASTER.stop(); print("\nstopped")
    elif a.cmd=="video":
        ok,msg=CASTER.video(a.file)
        if not ok: sys.exit(msg)
        print(f"video: {msg}. Serving until Ctrl-C.")
        try:
            while True: time.sleep(3600)
        except KeyboardInterrupt: CASTER.stop(); print("\nstopped")

if __name__=="__main__":
    main()
