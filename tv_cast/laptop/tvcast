#!/usr/bin/env python3
"""tvcast - one app to stream images (slideshow), videos, or a web page to a DLNA TV.

Pure Python standard library only, so it runs on the laptop OR on the robot (no pip installs).

Web UI:   tvcast serve [--port 8808] [--tv IP] [--dir FOLDER]
          then open the printed URL; load a folder, press Play, use Prev/Next.
CLI:      tvcast slides <folder> [--secs 5] [--loop] [--tv IP]
          tvcast video  <file>            [--tv IP]
          tvcast stop                     [--tv IP]

Images are shown with NO video encoding (the TV displays each file directly), so it is instant.
Videos are streamed as-is (no re-encoding). Only a web page -> scrolling video needs ffmpeg (laptop only);
tvcast calls the separate `tv-scroll` for that, it is not required for images or videos.
"""
import sys, os, re, ssl, json, html, time, socket, argparse, threading, urllib.request, http.server

DEFAULT_TV = "192.168.89.9"
AVT = "urn:schemas-upnp-org:service:AVTransport:1"
IMG_EXT = (".png",".jpg",".jpeg",".bmp",".webp",".gif")
VID_EXT = (".mp4",".m4v",".mkv",".mov",".avi",".webm",".ts",".mpg")

def local_ip_towards(host):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try: s.connect((host, 9197)); return s.getsockname()[0]
    finally: s.close()

def mime_for(path):
    e = os.path.splitext(path)[1].lower()
    return {".png":"image/png",".jpg":"image/jpeg",".jpeg":"image/jpeg",".bmp":"image/bmp",
            ".webp":"image/webp",".gif":"image/gif",".mp4":"video/mp4",".m4v":"video/mp4",
            ".mkv":"video/x-matroska",".mov":"video/quicktime",".avi":"video/avi",
            ".webm":"video/webm",".ts":"video/mpeg",".mpg":"video/mpeg"}.get(e,"application/octet-stream")

def is_image(p): return p.lower().endswith(IMG_EXT)

def numkey(p):
    b = os.path.splitext(os.path.basename(p))[0]
    m = re.match(r"^(-?\d+(?:\.\d+)?)", b)
    return (0, float(m.group(1))) if m else (1, b.lower())

class Caster:
    """Holds the playlist and drives the TV. Thread-safe enough for this use."""
    def __init__(self, tv_ip, serve_port):
        self.tv = f"{tv_ip}:9197"; self.ctrl = "/upnp/control/AVTransport1"
        self.ip = local_ip_towards(tv_ip); self.port = serve_port
        self.root = None; self.items = []; self.idx = 0
        self.secs = 5.0; self.loop = True; self.playing = False; self.mode = "idle"
        self._wake = threading.Event(); self._lock = threading.Lock()
        threading.Thread(target=self._worker, daemon=True).start()

    def set_tv(self, ip):
        ip=(ip or "").strip()
        if not ip: return
        self.tv = f"{ip}:9197"
        try: self.ip = local_ip_towards(ip)
        except Exception: pass

    def _soap(self, action, body):
        env = ('<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
               's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
               f'<s:Body><u:{action} xmlns:u="{AVT}">{body}</u:{action}></s:Body></s:Envelope>').encode()
        req = urllib.request.Request(f"http://{self.tv}{self.ctrl}", data=env,
              headers={"Content-Type":'text/xml; charset="utf-8"', "SOAPACTION":f'"{AVT}#{action}"'})
        try: return urllib.request.urlopen(req, timeout=8).read().decode(errors="ignore")
        except Exception as e: return f"<err>{e}</err>"

    def _url(self, name): return f"http://{self.ip}:{self.port}/media/{urllib.request.quote(name)}"

    def _push(self, name):
        url = self._url(name); mime = mime_for(name)
        cls = "object.item.imageItem" if mime.startswith("image/") else "object.item.videoItem"
        feat = "DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000"
        meta = html.escape('<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
            'xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/">'
            f'<item id="0" parentID="-1" restricted="1"><dc:title>{html.escape(name)}</dc:title>'
            f'<upnp:class>{cls}</upnp:class>'
            f'<res protocolInfo="http-get:*:{mime}:{feat}">{html.escape(url)}</res></item></DIDL-Lite>')
        self._soap("SetAVTransportURI", f"<InstanceID>0</InstanceID><CurrentURI>{html.escape(url)}</CurrentURI>"
                   f"<CurrentURIMetaData>{meta}</CurrentURIMetaData>")
        self._soap("Play", "<InstanceID>0</InstanceID><Speed>1</Speed>")

    def _worker(self):
        while True:
            if self.playing and self.items and self.mode == "slides":
                with self._lock: name = self.items[self.idx]
                self._push(name)
                self._wake.wait(self.secs); self._wake.clear()
                if not (self.playing and self.mode == "slides"): continue
                with self._lock:
                    if self.idx + 1 < len(self.items): self.idx += 1
                    elif self.loop: self.idx = 0
                    else: self.playing = False
            else:
                self._wake.wait(0.5); self._wake.clear()

    # ---- control API ----
    def open_dir(self, d):
        d = os.path.expanduser(d)
        if not os.path.isdir(d): return False, "not a folder"
        imgs = sorted([f for f in os.listdir(d) if f.lower().endswith(IMG_EXT)], key=lambda f: numkey(f))
        if not imgs: return False, "no images in folder"
        with self._lock:
            self.root = d; self.items = imgs; self.idx = 0; self.mode = "slides"; self.playing = False
        return True, f"{len(imgs)} images"
    def play(self):  self.playing = True; self._wake.set()
    def pause(self): self.playing = False; self._wake.set()
    def nxt(self):
        with self._lock:
            if self.items: self.idx = (self.idx + 1) % len(self.items)
        self._push(self.items[self.idx]) if self.items else None; self._wake.set()
    def prev(self):
        with self._lock:
            if self.items: self.idx = (self.idx - 1) % len(self.items)
        self._push(self.items[self.idx]) if self.items else None; self._wake.set()
    def goto(self, i):
        with self._lock:
            if self.items and 0 <= i < len(self.items): self.idx = i
        self._push(self.items[self.idx]) if self.items else None; self._wake.set()
    def video(self, path):
        path = os.path.expanduser(path)
        if not os.path.isfile(path): return False, "no such file"
        with self._lock:
            self.root = os.path.dirname(path) or "."; self.items = [os.path.basename(path)]
            self.idx = 0; self.mode = "video"; self.playing = False
        self._push(self.items[0]); return True, "streaming video"
    def stop(self):
        self.playing = False; self.mode = "idle"; self._wake.set()
        self._soap("Stop", "<InstanceID>0</InstanceID>")
    def status(self):
        with self._lock:
            return {"mode":self.mode,"playing":self.playing,"idx":self.idx,"count":len(self.items),
                    "secs":self.secs,"loop":self.loop,"tv":self.tv.split(":")[0],"root":self.root,
                    "current":(self.items[self.idx] if self.items else None),"items":self.items}

CASTER = None

